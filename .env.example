# RoomFit サーバーの設定例。値を入れたものを環境変数として渡します（このファイル自体は読み込みません）。
# 秘密の値をリポジトリや Web 側のコードに書かないでください。

# 楽天市場 商品検索API のアプリID（未設定なら商品検索は「未設定」と表示され、手入力での登録だけになります）
RAKUTEN_APP_ID=
# 楽天アフィリエイトID（任意。設定するとリンクがアフィリエイトリンクになり、画面にその旨を表示します）
RAKUTEN_AFFILIATE_ID=

# 写真・復元結果・ジョブ記録の保存先（既定: server/data）
ROOMFIT_DATA_DIR=
# 1 回の復元で受け付ける写真の最大枚数（既定: 24。メモリ 16GB の PC での安全側の値。未検証の上限です）
ROOMFIT_MAX_PHOTOS=24
